<?xml version='1.0' encoding='utf-8'?>
<otobo_package version="1.0">
  <Name>CK5-FullWindowMode</Name>
  <Version>0.0.0</Version>
  <Framework Minimum="11.0.14">11.0.x</Framework>
  <Vendor>Rother OSS GmbH</Vendor>
  <URL>https://otobo.io/</URL>
  <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
  <Description Lang="en">Adds a Fullscreen mode for the text editor.</Description>
  <Description Lang="de">Fügt eine Fullscreen Ansicht für den Text Editor hinzu.</Description>
  <Filelist>
    <File Permission="660" Location="var/httpd/htdocs/skins/Agent/default/css/CKEditorCustomStyles.css" />
	  <File Permission="660" Location="var/httpd/htdocs/skins/Customer/default/css/CKEditorCustomStyles.css" />
    <File Permission="660" Location="var/httpd/htdocs/js/Core.UI.CKEditor5Wrapper.js" />
    <File Permission="660" Location="var/httpd/htdocs/js/Core.UI.RichTextEditor.js" />
    <File Permission="660" Location="Kernel/Config/Files/XML/CK5FullWindowMode.xml" />
    <File Permission="660" Location="Custom/Kernel/Output/HTML/Layout.pm" />
  </Filelist>
</otobo_package>
